{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ondetour.app/schemas/ai-trip/order.schema.json",
  "title": "AI trip — itinerary ordering",
  "description": "Output of orderByClaudeOrDistance. Parsed by AiTripServiceImpl.parseCandidateOrder. Must be a permutation of the input IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateIds"],
  "properties": {
    "candidateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
